{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__Linear",
      "mcp__Obsidian"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force* origin main*)",
      "Bash(git push --force* origin HEAD:main*)",
      "Bash(git push -f* origin main*)",
      "Bash(git push -f* origin HEAD:main*)"
    ]
  }
}
